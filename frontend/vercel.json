{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "fight-intelligence.vercel.app" }],
      "destination": "https://www.vektormma.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ufc-fight-predictor-api-production.up.railway.app/:path*"
    },
    {
      "source": "/:lang(en|fr|es)/:path*",
      "destination": "/:lang/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
