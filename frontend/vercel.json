{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "fight-intelligence.vercel.app" }],
      "destination": "https://www.vektormma.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ufcpredictor-fxg8.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
